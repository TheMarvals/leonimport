# Base de datos
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/leonimport_wms?schema=public"
DIRECT_URL="postgresql://postgres:postgres@postgres:5432/leonimport_wms?schema=public"

# Redis
REDIS_URL="redis://redis:6379"

# Sesión
# Obligatorio en producción: mínimo 32 caracteres. Generar con:
# openssl rand -base64 48
SESSION_SECRET="reemplaza-con-un-secreto-aleatorio-de-64-caracteres"

# App
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Mercado Libre
ML_GATEWAY_URL="https://gateway.themarvals.com"
# Solo el secreto. No incluir el prefijo "app-id:" usado en API_KEYS del gateway.
ML_GATEWAY_API_KEY="tu-clave"
ML_GATEWAY_APP_ID="leon-import-wms"
ML_ACCOUNT_ID="tu-account-id"
ML_SELLER_ID="tu-seller-id"

# QZ Tray (opcional). Sin QZ instalado, el WMS usa impresión manual.
# Para impresión silenciosa gratuita, usa un certificado raíz propio y guarda
# el certificado público y la clave privada PEM en el servidor.
QZ_CERTIFICATE=""
QZ_PRIVATE_KEY=""
# Ventana global entre sincronizaciones automáticas solicitadas por estaciones.
# Los botones manuales pueden forzar una sincronización inmediata.
ML_SYNC_COOLDOWN_SECONDS=90
